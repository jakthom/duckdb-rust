CREATE TABLE w(p INTEGER,k INTEGER,v INTEGER); INSERT INTO w VALUES (1,1,10),(1,2,NULL),(1,2,20),(1,4,40),(2,1,5),(2,3,15),(NULL,1,7)

query IIIII
SELECT p,k,row_number() OVER (PARTITION BY p ORDER BY k,v),rank() OVER (PARTITION BY p ORDER BY k),dense_rank() OVER (PARTITION BY p ORDER BY k) FROM w ORDER BY p,k,v
----
1	1	1	1	1
1	2	2	2	2
1	2	3	2	2
1	4	4	4	3
2	1	1	1	1
2	3	2	2	2
NULL	1	1	1	1

query IIII
