# Grouping sets preserve subtotal identity independently of SQL NULL.

statement ok
CREATE TABLE sales(a INTEGER, b INTEGER, v INTEGER)

statement ok
INSERT INTO sales VALUES (1,10,2),(1,10,3),(1,NULL,5),(2,10,NULL),(NULL,10,7)

query IIIII rowsort
SELECT a,b,count(*),sum(v),grouping(a,b) FROM sales GROUP BY GROUPING SETS ((a,b),(a),(b),())
----
1	10	2	5	0
1	NULL	1	5	0
1	NULL	3	10	1
2	10	1	NULL	0
2	NULL	1	NULL	1
NULL	10	1	7	0
NULL	10	4	12	2
NULL	NULL	1	5	2
NULL	NULL	1	7	1
NULL	NULL	5	17	3

query IIIII rowsort
SELECT a,b,count(*),sum(v),grouping(a,b) FROM sales GROUP BY ROLLUP(a,b)
----
