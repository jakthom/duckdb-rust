# Table metadata, stored values and constraints evolve in the same transaction.
statement ok
CREATE TABLE t(id INTEGER PRIMARY KEY, v VARCHAR DEFAULT 'initial')

statement ok
INSERT INTO t(id) VALUES(1),(2)

statement ok
DELETE FROM t WHERE id=1

statement ok
ALTER TABLE t ADD COLUMN n SMALLINT DEFAULT 7

query ITI
SELECT * FROM t
----
2	initial	7

statement ok
ALTER TABLE t ALTER COLUMN n SET DEFAULT 9

statement ok
INSERT INTO t(id) VALUES(3)

query II
SELECT id,n FROM t ORDER BY id
----
2	7
3	9

statement ok
ALTER TABLE t RENAME COLUMN v TO label

statement ok
ALTER TABLE t RENAME TO renamed

statement error
SELECT * FROM t
----

statement error
SELECT v FROM renamed
----

statement ok
ALTER TABLE renamed ALTER COLUMN n SET NOT NULL

statement error
INSERT INTO renamed VALUES(4,'invalid',NULL)
----

statement error
ALTER TABLE renamed ALTER COLUMN id DROP NOT NULL
----

statement ok
ALTER TABLE renamed ALTER COLUMN n DROP NOT NULL

statement ok
ALTER TABLE renamed ALTER COLUMN n DROP DEFAULT

statement ok
INSERT INTO renamed(id) VALUES(4)

query II
SELECT id,n FROM renamed ORDER BY id
----
2	7
3	9
4	NULL

statement error
ALTER TABLE renamed ALTER COLUMN n SET NOT NULL
----

statement ok
UPDATE renamed SET n=10 WHERE n IS NULL

statement ok
ALTER TABLE renamed ALTER COLUMN n SET NOT NULL

statement ok
ALTER TABLE renamed DROP COLUMN label

query II
