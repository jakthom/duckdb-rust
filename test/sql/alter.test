----

statement ok
ALTER TABLE renamed ADD COLUMN IF NOT EXISTS n BIGINT DEFAULT 500

statement ok
INSERT INTO renamed VALUES(5,11)

statement ok
ALTER TABLE renamed DROP COLUMN IF EXISTS absent

statement ok
ALTER TABLE IF EXISTS absent ADD COLUMN v BIGINT

statement ok
