statement ok
CREATE TABLE strings(g INTEGER, x VARCHAR, y VARCHAR);

statement ok
INSERT INTO strings VALUES (1,'a','/'), (1,'b','-'), (2,'i','/'), (2,NULL,'-'), (2,'j','+'), (3,'p','/'), (4,'x','/'), (4,'y','-'), (4,'z','+')

statement error
