CREATE TABLE c2_string_agg_process AS SELECT i, i%64 AS g, CASE WHEN i%17=16 THEN NULL WHEN i%7=0 THEN 'xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx' ELSE 'v' || (i%31)::VARCHAR END AS value FROM range(50000) t(i);

loop iteration 0 128

query I
SELECT count(*) FROM (SELECT string_agg(value, '|') FROM c2_string_agg_process GROUP BY g) t;
----
64

query I
SELECT count(*) FROM (SELECT sum(i), list_extract(list(value ORDER BY i), 1), string_agg(value, '|') FROM c2_string_agg_process GROUP BY g) t;
----
64

endloop
