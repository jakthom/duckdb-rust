# G06.1b VARCHAR character-length and substring workloads. The source data
# retains ASCII, Unicode and empty values while exercising dictionary batches.
# The first query is the fused character-count consumer. The remaining queries
# project VARCHAR directly, so the runner transports the produced text. The
# final query has more than the substring cache cap's distinct
# (value, start, length) triples per batch.
statement ok
CREATE TABLE g06_substring(v VARCHAR, start BIGINT, count BIGINT, unique_start BIGINT);

statement ok
INSERT INTO g06_substring
SELECT CASE i % 4 WHEN 0 THEN 'alphabet soup' WHEN 1 THEN 'é🦆x' WHEN 2 THEN 'aé' ELSE '' END,
       CASE i % 4 WHEN 0 THEN 2 WHEN 1 THEN -2 WHEN 2 THEN 0 ELSE 1 END,
       CASE i % 4 WHEN 0 THEN 6 WHEN 1 THEN 1 WHEN 2 THEN 3 ELSE 0 END,
       i % 100
FROM range(50000) t(i);

query I
SELECT sum(length(substring(v,start,count))) FROM g06_substring;
----
112500

query T
SELECT substring(v,start,count) FROM g06_substring;
----
50000 values hashing to 81079a12d43c2172212ce0278ad143f3

query T
SELECT substring(v,unique_start,1) FROM g06_substring;
----
50000 values hashing to a18d57fb2a2221b82d1ada186974e057
