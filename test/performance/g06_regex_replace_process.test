# G06.2b constant-pattern global replacement workload: 128 * 50k = 6.4m
# stored-column row visits through the SQLLogic runner.
statement ok
CREATE TABLE g06_regex_replace_process AS
SELECT i::VARCHAR || '-' ||
       CASE i % 4 WHEN 0 THEN 'alpha' WHEN 1 THEN 'beta' WHEN 2 THEN 'gamma' ELSE 'delta' END AS v
FROM range(50000) t(i);

loop iteration 0 128

query I
SELECT sum(strlen(regexp_replace(v, '[0-9]', 'X', 'g')))
FROM g06_regex_replace_process;
----
526390

endloop
