statement ok
CREATE TABLE c1_1_named_regex_process AS SELECT i, i::VARCHAR || '-alpha ' || (i + 1)::VARCHAR || '-beta' AS v FROM range(50000) t(i);

loop iteration 0 128

query I
SELECT sum(CASE WHEN x IS NOT DISTINCT FROM struct_pack(number := i::VARCHAR, word := 'alpha') THEN 1 ELSE 0 END) FROM (SELECT i, regexp_extract(v, '([0-9]+)-([a-z]+)', ['number','word']) AS x FROM c1_1_named_regex_process) t;
