# G06.1d process-level NUL-safe chr/ascii workload: 128 * 50k = 6.4m
# stored-column row-visits through the SQLLogic runner.
statement ok
CREATE TABLE g06_text_chr_ascii_process AS
SELECT CASE i % 4 WHEN 0 THEN 0 WHEN 1 THEN 65 WHEN 2 THEN 129414 ELSE 233 END AS code
FROM range(50000) t(i);

loop iteration 0 128

query I
SELECT sum(ascii(chr(code)))
FROM g06_text_chr_ascii_process;
----
1621400000

endloop
