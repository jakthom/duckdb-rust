# G01.2c source-matched loop, concurrent scheduling, and lifecycle workload.

load {TEST_DIR}/g01_2c_loop_sessions.duckdb

statement ok writer
CREATE TABLE state(i INTEGER); INSERT INTO state VALUES (1), (2)

statement ok reader
BEGIN

query I reader
SELECT count(*) FROM state
----
2

statement ok writer
INSERT INTO state VALUES (3)

reconnect

query I reader
SELECT count(*) FROM state
----
2

query I
SELECT count(*) FROM state
----
3

restart

query I
SELECT sum(i) FROM state
----
6

# Both pinned command implementations execute the start once when start >= end.
loop odd 3 1

query I
SELECT {odd}
----
3

endloop

loop i -1 2

onlyif i>=-1&&i<=1
query I
SELECT {i}
----
{i}

endloop

concurrentloop threadid 0 4

query II
SELECT {threadid}, sum(i) FROM range(100000) values(i)
----
{threadid}	4999950000

endloop

query I
SELECT 42
----
42
