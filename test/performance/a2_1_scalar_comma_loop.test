# A2.1 shared runner workload: scalar comma values must remain scalar while
# tuple iterators retain positional replacement after empty components drop.

foreach datatype DECIMAL(4,1) DECIMAL(4,1) DECIMAL(4,1)

query T
SELECT '{datatype}'
----
DECIMAL(4,1)

endloop

foreach left,right first,,last first,,last

query T
SELECT '{left}:{right}'
----
first:last

endloop
