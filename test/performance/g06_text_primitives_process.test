# G06.1d process-level low-cardinality grapheme workload: 128 * 50k = 6.4m
# stored-column row-visits through the SQLLogic runner.
statement ok
CREATE TABLE g06_text_primitives_process AS
SELECT CASE i % 4 WHEN 0 THEN 'á👩🏽‍💻Z' WHEN 1 THEN '🇺🇳x' WHEN 2 THEN '♥️é' ELSE '' END AS v,
       CASE i % 4 WHEN 0 THEN 2 WHEN 1 THEN -1 WHEN 2 THEN 1 ELSE 1 END AS start_at,
       CASE i % 4 WHEN 0 THEN 1 WHEN 1 THEN 1 WHEN 2 THEN 2 ELSE 1 END AS take
FROM range(50000) t(i);

loop iteration 0 128

query I
SELECT sum(length_grapheme(substring_grapheme(v, start_at, take)))
FROM g06_text_primitives_process;
----
50000

endloop
