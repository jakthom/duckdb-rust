# G03.3a source-shaped ENUM range-boundary workload.
# Both pins implement the family in
# extension/core_functions/scalar/enum/enum_functions.cpp.

statement ok
CREATE TABLE enum_boundary AS SELECT CASE WHEN i%2=0 THEN 'z' ELSE 'a' END::ENUM('z','a') AS k FROM range(50000) t(i)

hash-threshold 1

query TT
SELECT enum_range_boundary(k,NULL), enum_range_boundary(NULL::ENUM('z','a'),k) FROM enum_boundary
